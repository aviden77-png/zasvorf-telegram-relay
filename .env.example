# Relay-only secrets. Никогда не задавайте NEXT_PUBLIC_* варианты.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_RELAY_SECRET=
# Куда relay передаёт ответ оператора. Пример: https://zasvorf.pro/api/chat/reply
# Нужна на том Vercel-проекте, чей адрес указан в setWebhook.
# /api/chat и /api/lead работают и без неё.
CHAT_REPLY_URL=
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token для setWebhook.
# Тот же секрет задайте на обоих Vercel-проектах этого репозитория.
TELEGRAM_WEBHOOK_SECRET=
